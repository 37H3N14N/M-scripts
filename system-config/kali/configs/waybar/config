{
    "layer": "top", // Waybar on top of windows
    "position": "bottom", // Positioned at the bottom
    "height": 30, // Minimalist height
    "spacing": 4, // Gaps between modules
    "modules-left": ["sway/workspaces"],
    "modules-center": ["network"],
    "modules-right": ["cpu", "memory"],

    "sway/workspaces": {
        "disable-scroll": true, // Disable scroll to change workspace
        "all-outputs": true,
        "format": "{name}", // Only show name/number
        "on-click": "none", // Non-clickable workspaces
        "interval": 4
    },
    
    "network": {
        // No icons, just text speeds
        "format-wifi": "{essid} ({signalStrength}%) ⬇{bandwidthDownBytes} ⬆{bandwidthUpBytes}",
        "format-ethernet": "eth ⬇{bandwidthDownBytes} ⬆{bandwidthUpBytes}",
        "format-disconnected": "disconnected",
        "interval": 2
    },

    "cpu": {
        "format": "[CPU] {usage}%",
        "tooltip": false
    },

    "memory": {
 	"format": "[RAM] {used:0.1f}G", 
        "interval": 2
    }
}

